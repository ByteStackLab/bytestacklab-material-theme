    "statusBar.debuggingForeground": "#0F111A",
    "titleBar.activeBackground": "#0F111A",
    "titleBar.activeForeground": "#BABED8",
    "titleBar.inactiveBackground": "#090B10",
    "tab.activeBackground": "#0F111A",
    "tab.activeForeground": "#BABED8",
    "tab.inactiveBackground": "#090B10",
    "tab.inactiveForeground": "#4B526D",
    "tab.activeBorder": "#84FFFF",
    "panel.background": "#090B10",
    "panelTitle.activeForeground": "#BABED8",
    "panelTitle.inactiveForeground": "#4B526D",
    "terminal.background": "#090B10",
    "terminal.foreground": "#BABED8",
    "terminal.ansiBlack": "#464B5D",
    "terminal.ansiRed": "#F07178",
