    "editor.lineHighlightBackground": "#00000030",
    "editorWhitespace.foreground": "#2A2E3F",
    "editorIndentGuide.background1": "#1F2233",
    "editorIndentGuide.activeBackground1": "#3B3F51",
    "editorWidget.background": "#1A1C25",
    "editorHoverWidget.background": "#1A1C25",
    "editorSuggestWidget.background": "#1A1C25",
    "editorSuggestWidget.selectedBackground": "#1F2233",
    "editorGroupHeader.tabsBackground": "#090B10",
